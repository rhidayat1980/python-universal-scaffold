[project]
name = "{{ project_name }}"
version = "0.1.0"
description = "Production-grade {{ project_archetype }} scaffolded with mise, uv, and taskfile"
readme = "README.md"
requires-python = ">={{ python_version }}"
authors = [
    { name = "{{ author_name }}", email = "{{ author_email }}" }
]
dependencies = [
    "structlog>=24.4.0",
    "pydantic>=2.8.0",
    "pydantic-settings>=2.4.0",
{% if include_database %}
    "sqlalchemy[asyncio]>=2.0.30",
    "asyncpg>=0.29.0",
    "alembic>=1.13.0",
{% endif %}
{% if project_archetype == 'api-service' %}
    "fastapi>=0.115.0",
    "uvicorn[standard]>=0.30.0",
{% elif project_archetype == 'data-analytics' %}
    "polars>=1.6.0",
    "duckdb>=1.0.0",
    "pyarrow>=17.0.0",
    "jupyterlab>=4.2.0",
{% elif project_archetype == 'ai-ml' %}
    "numpy>=2.0.0",
    "huggingface-hub>=0.24.0",
    "torch>=2.4.0",
{% elif project_archetype == 'pipeline-worker' %}
    "redis>=5.0.0",
    "tenacity>=9.0.0",
{% elif project_archetype == 'cli-tool' %}
    "typer>=0.12.0",
    "rich>=13.7.0",
{% elif project_archetype == 'library-package' %}
    # Minimal external dependencies for library package
{% endif %}
]

[dependency-groups]
dev = [
    "pytest>=8.3.0",
    "pytest-cov>=5.0.0",
    "pytest-asyncio>=0.24.0",
    "ruff>=0.6.0",
    "pyright>=1.1.370",
    "bandit>=1.7.9",
    "pip-audit>=2.7.3",
{% if project_archetype == 'api-service' %}
    "httpx>=0.27.0",
{% endif %}
]

{% if project_archetype == 'ai-ml' %}
[[tool.uv.index]]
{% if compute_target == 'cuda-12' %}
name = "pytorch-cu121"
url = "https://download.pytorch.org/whl/cu121"
explicit = true
{% else %}
name = "pytorch-cpu"
url = "https://download.pytorch.org/whl/cpu"
explicit = true
{% endif %}

[tool.uv.sources]
{% if compute_target == 'cuda-12' %}
torch = { index = "pytorch-cu121" }
{% else %}
torch = { index = "pytorch-cpu" }
{% endif %}
{% endif %}

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/{{ package_name }}"]

[tool.ruff]
line-length = 100
target-version = "py{{ python_version | replace('.', '') }}"
src = ["src"]

[tool.ruff.lint]
select = ["E", "F", "I", "UP", "B", "SIM", "ASYNC", "S"]
ignore = ["S101"] # allow assert in tests

[tool.pyright]
include = ["src"]
pythonVersion = "{{ python_version }}"
typeCheckingMode = "standard"

[tool.pytest.ini_options]
asyncio_mode = "auto"
testpaths = ["tests"]
pythonpath = ["src"]
