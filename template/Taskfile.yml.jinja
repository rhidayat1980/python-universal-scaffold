version: '3'

tasks:
  setup:
    desc: "Initialize local environment, copy .env, and sync dependencies"
    cmds:
      - test -f .env || cp .env.example .env
      - uv sync
    sources:
      - pyproject.toml
      - .python-version
    generates:
      - uv.lock

{% if project_archetype == 'api-service' %}
  dev:
    desc: "Run FastAPI dev server with auto-reload"
    cmd: uv run uvicorn {{ package_name }}.main:app --reload --host 0.0.0.0 --port 8000

{% if include_database %}
  db:migrate:
    desc: "Apply database migrations"
    cmd: uv run alembic upgrade head

  db:makemigrations:
    desc: "Create new migration revision (use CLI_ARGS for message)"
    cmd: uv run alembic revision --autogenerate -m "{% raw %}{{.CLI_ARGS}}{% endraw %}"
{% endif %}
{% elif project_archetype == 'data-analytics' %}
  notebook:
    desc: "Open JupyterLab environment"
    cmd: uv run jupyter lab --ip 0.0.0.0

  run:
    desc: "Execute data transformation pipeline"
    cmd: uv run python -m {{ package_name }}.pipelines.transform
{% elif project_archetype == 'ai-ml' %}
  train:
    desc: "Start model training script"
    cmd: uv run python -m {{ package_name }}.training.train

  eval:
    desc: "Run model evaluation / inference"
    cmd: uv run python -m {{ package_name }}.inference
{% elif project_archetype == 'pipeline-worker' %}
  worker:
    desc: "Run async worker consumer"
    cmd: uv run python -m {{ package_name }}.worker
{% elif project_archetype == 'cli-tool' %}
  run:
    desc: "Run CLI tool locally"
    cmd: uv run python -m {{ package_name }}.cli {% raw %}{{.CLI_ARGS}}{% endraw %}
{% elif project_archetype == 'library-package' %}
  build:
    desc: "Build wheel and sdist distribution packages"
    cmd: uv build
{% endif %}

  test:
    desc: "Run unit tests and test coverage"
    cmd: uv run pytest --cov=src/{{ package_name }} --cov-report=term-missing

  typecheck:
    desc: "Validate static type safety using Pyright"
    cmd: uv run pyright

  lint:
    desc: "Check linting and formatting with Ruff"
    cmds:
      - uv run ruff check .
      - uv run ruff format --check .

  fix:
    desc: "Auto-format and fix lint issues"
    cmds:
      - uv run ruff format .
      - uv run ruff check --fix .

  audit:deps:
    desc: "Audit third-party dependencies for CVEs"
    cmd: uv run pip-audit

  audit:sast:
    desc: "Static Application Security Testing (SAST) using Bandit"
    cmd: uv run bandit -r src/ -c pyproject.toml

  check:all:
    desc: "Comprehensive quality gate (Lint + Typecheck + Test + Security)"
    cmds:
      - task: lint
      - task: typecheck
      - task: test
      - task: audit:deps
      - task: audit:sast

  update:template:
    desc: "Update project with latest improvements from template repository"
    cmd: copier update

{% if include_container %}
  docker:build:
    desc: "Build production Docker container image"
    cmd: docker build -t {{ project_name }}:latest .

  docker:run:
    desc: "Run Docker container locally"
{% if project_archetype == 'api-service' %}
    cmd: docker run --rm -p 8000:8000 --env-file .env {{ project_name }}:latest
{% else %}
    cmd: docker run --rm --env-file .env {{ project_name }}:latest
{% endif %}
{% endif %}
